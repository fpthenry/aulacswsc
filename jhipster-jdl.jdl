/*
 * JDL cho website Spa - aulacswsc
 * - Xác thực JWT, User/Authority có sẵn của JHipster (jhi_user)
 * - Khách hàng & nhân viên liên kết 1-1 với tài khoản User
 */

application {
  config {
    baseName aulacswsc
    applicationType monolith
    packageName com.mycompany.myapp
    authenticationType jwt
    buildTool maven
    clientFramework angular
    databaseType sql
    devDatabaseType mysql
    prodDatabaseType mysql
    cacheProvider no
    enableHibernateCache false
    enableTranslation true
    nativeLanguage en
    languages [en, vi]
    enableSwaggerCodegen true
    withAdminUi true
  }
  entities *
}

// ===================== ENUMS =====================

enum Gender {
  MALE, FEMALE, OTHER
}

enum BookingStatus {
  PENDING, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
}

enum PaymentStatus {
  UNPAID, PAID, REFUNDED
}

enum PaymentMethod {
  CASH, BANK_TRANSFER, CARD, E_WALLET
}

// ===================== DỊCH VỤ =====================

/** Danh mục dịch vụ (Chăm sóc da, Massage, Gội đầu dưỡng sinh...) */
entity ServiceCategory {
  name String required maxlength(150)
  slug String required unique maxlength(180)
  description TextBlob
  imageUrl String maxlength(500)
  displayOrder Integer
  active Boolean required
}

/** Dịch vụ spa cụ thể */
entity SpaService {
  name String required maxlength(200)
  slug String required unique maxlength(220)
  shortDescription String maxlength(500)
  description TextBlob
  price BigDecimal required min(0)
  salePrice BigDecimal min(0)
  durationMinutes Integer required min(5)
  imageUrl String maxlength(500)
  featured Boolean
  active Boolean required
}

// ===================== CON NGƯỜI =====================

/** Hồ sơ khách hàng, gắn với tài khoản User (có thể null nếu khách đặt lịch không đăng ký) */
entity Customer {
  fullName String required maxlength(150)
  phone String required unique maxlength(20)
  email String maxlength(150)
  gender Gender
  dateOfBirth LocalDate
  address String maxlength(300)
  note TextBlob
  createdDate Instant
}

/** Kỹ thuật viên / nhân viên spa, gắn với tài khoản User */
entity Staff {
  fullName String required maxlength(150)
  phone String maxlength(20)
  position String maxlength(100)
  bio TextBlob
  avatarUrl String maxlength(500)
  active Boolean required
}

// ===================== ĐẶT LỊCH =====================

/** Lịch hẹn */
entity Booking {
  code String required unique maxlength(30)
  startTime Instant required
  endTime Instant
  status BookingStatus required
  totalAmount BigDecimal min(0)
  discountAmount BigDecimal min(0)
  paymentStatus PaymentStatus
  paymentMethod PaymentMethod
  note String maxlength(1000)
  createdDate Instant
}

/** Chi tiết dịch vụ trong một lịch hẹn */
entity BookingItem {
  price BigDecimal required min(0)
  quantity Integer required min(1)
  durationMinutes Integer
}

/** Mã khuyến mãi */
entity Promotion {
  code String required unique maxlength(50)
  name String required maxlength(200)
  description String maxlength(1000)
  discountPercent Integer min(0) max(100)
  discountAmount BigDecimal min(0)
  startDate Instant
  endDate Instant
  active Boolean required
}

// ===================== NỘI DUNG WEBSITE =====================

/** Đánh giá dịch vụ */
entity Review {
  rating Integer required min(1) max(5)
  comment String maxlength(2000)
  approved Boolean
  createdDate Instant
}

/** Liên hệ từ form trên website */
entity ContactMessage {
  fullName String required maxlength(150)
  phone String maxlength(20)
  email String maxlength(150)
  message String required maxlength(2000)
  handled Boolean
  createdDate Instant
}

// ===================== QUAN HỆ =====================

relationship OneToOne {
  Customer{user(login)} to User with builtInEntity
  Staff{user(login)} to User with builtInEntity
}

relationship OneToMany {
  ServiceCategory{services} to SpaService{category(name) required}
  Customer{bookings} to Booking{customer(fullName) required}
  Booking{items} to BookingItem{booking(code) required}
}

relationship ManyToOne {
  BookingItem{service(name) required} to SpaService
  BookingItem{staff(fullName)} to Staff
  Booking{promotion(code)} to Promotion
  Review{customer(fullName) required} to Customer
  Review{service(name) required} to SpaService
}

relationship ManyToMany {
  Staff{services(name)} to SpaService{staffs}
}

// ===================== TÙY CHỌN =====================

dto * with mapstruct
service * with serviceImpl
filter ServiceCategory, SpaService, Customer, Staff, Booking, Promotion, Review, ContactMessage

paginate SpaService, Customer, Booking, Review, ContactMessage with pagination
paginate ServiceCategory, Staff, Promotion with infinite-scroll
